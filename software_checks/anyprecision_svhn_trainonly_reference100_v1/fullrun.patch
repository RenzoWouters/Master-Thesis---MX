+def completion_summary(records: list[dict], c: dict, synthetic: bool) -> tuple[dict, list[dict]]:
+    """Validate the complete saved trajectory without model calls or RNG draws."""
+    s.require(bool(records), 'Geen epochs voor eindcontrole.')
+    done = records[-1]['epoch']
+    s.require([r['epoch'] for r in records] == list(range(1, done + 1)),
+              'Ontbrekende, dubbele of ongeordende epochs in geschiedenis.')
+    s.require(done <= c['planned_epochs'], 'Meer epochs dan afgesproken.')
+    steps_per_epoch = math.ceil(c['train_examples'] / c['batch_size'])
+    lr_rows = []
+    for record in records:
+        ep = record['epoch']
+        used = c['lr']
+        next_lr = c['lr']
+        for milestone in c['scheduler_milestones']:
+            if milestone < ep:
+                used *= c['scheduler_gamma']
+            if milestone <= ep:
+                next_lr *= c['scheduler_gamma']
+        s.require(record['lr_used'] == used and record['lr_next'] == next_lr,
+                  'Onjuist LR-schema in opgeslagen epoch ' + str(ep))
+        s.require(record['optimizer_steps'] == ep * steps_per_epoch, 'Onjuist totaal optimizerstappen.')
+        s.require(record['batchnorm_counters_correct'], 'BatchNorm-tellers wijken af.')
+        for phase, expected in [('train', c['train_examples']), ('test', c['test_examples'])]:
+            rows = record[phase]
+            s.require([r['bits_w_and_a'] for r in rows] == c['bits'], 'Onjuiste precisierijen.')
+            s.require(record['coverage'][phase]['complete_once'], 'Onvolledige datadekking.')
+            s.require(record['coverage'][phase]['n'] == expected, 'Onjuist aantal voorbeelden.')
+            for row in rows:
+                s.require(row['epoch'] == ep and row['phase'] == phase and row['n'] == expected,
+                          'Onjuiste metric-identiteit of voorbeeldtelling.')
+                s.require(row['lr'] == used, 'LR in metric wijkt af.')
+                s.require(all(math.isfinite(float(row[k])) for k in
+                              ['objective_loss', 'top1_percent', 'top5_percent']), 'Niet-eindige metrics.')
+                s.require(abs(row['top1_percent'] - 100 * row['correct1'] / expected) < 0.0001,
+                          'Accuracy en correct-aantal spreken elkaar tegen.')
+        lr_rows.append({'epoch': ep, 'lr_used': used, 'lr_after_epoch': next_lr,
+                        'optimizer_steps': record['optimizer_steps']})
+    times = [r.get('total_epoch_seconds') for r in records]
+    timing_complete = all(t is not None and math.isfinite(float(t)) and t >= 0 for t in times)
+    summary = {
+        'schema': 'svhn-trainonly100-completion-v1', 'synthetic_fixture_only': synthetic,
+        'planned_epochs': c['planned_epochs'], 'completed_epochs': done,
+        'full_training_completed': done == c['planned_epochs'],
+        'optimizer_steps': records[-1]['optimizer_steps'],
+        'expected_optimizer_steps_at_completion': steps_per_epoch * c['planned_epochs'],
+        'all_epoch_precisions_complete': True, 'lr_schedule_verified': True,
+        'train_split': c['train_split'], 'extra_used': c['extra_used'],
+        'timing_complete': timing_complete,
+        'measured_completed_epoch_seconds': sum(times) if timing_complete else None,
+        'measured_time_scope': 'train + test + controls + checkpoint writes; excludes startup/final export',
+        'best_epoch_W32_A32': s.best_record(records)['epoch'], 'last_epoch': done,
+        'new_initialization_required_for_run': True,
+        'no_MX_or_stored_code_truncation': True,
+    }
+    return summary, lr_rows
+
