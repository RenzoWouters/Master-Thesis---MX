+        comparison_is_historical=True, exact_CUDA_repeat_not_claimed=True,
+        source_reference_sha256=s.legacy.sha256(reference['directory']/'REFERENCE.json'))
+    s.write_json(out / 'initialization_reference_report.json', result)
